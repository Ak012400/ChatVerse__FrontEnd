# ChatVerse frontend — environment template
# Copy to .env.local for dev, set as env vars in Vercel for prod.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.

# Production backend URL (Render). Locally Vite proxies /api so leave blank.
VITE_API_BASE_URL=https://your-backend.onrender.com

# Optional override for the SignalR hub base if it ever differs from API base.
# VITE_SIGNALR_URL=https://your-backend.onrender.com

# LiveKit WSS URL — usually same as backend's LiveKit:ServerUrl
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Google OAuth Client ID (from console.cloud.google.com → Credentials → Web app).
# Same value as backend's Google__ClientId. This one is browser-public.
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
